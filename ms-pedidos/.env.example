# Copia este archivo como .env y ajusta los valores a tu XAMPP
APP_DEBUG=true
APP_TIMEZONE=America/Bogota
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ms_pedidos
# Base de datos de ms-auth (solo LECTURA, para validar el token)
AUTH_DB_NAME=ms_auth
# Base de datos de ms-reservas (solo LECTURA, para validar el estado de la mesa)
RESERVAS_DB_NAME=ms_reservas
